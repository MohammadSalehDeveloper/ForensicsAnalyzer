@page "/cases"
@using Microsoft.AspNetCore.Authorization
@using ForensicsAnalyzer.Contracts.Cases
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager NavigationManager

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1>Cases</h1>
            <p class="text-muted">Manage your forensics cases</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateModal">
                <i class="bi bi-plus-lg"></i> New Case
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    }
    else if (string.IsNullOrEmpty(errorMessage))
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Case ID</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cases?.Count > 0)
                    {
                        @foreach (var case_ in cases)
                        {
                            <tr>
                                <td>@case_.Id</td>
                                <td>@case_.Name</td>
                                <td>@case_.Description</td>
                                <td>@case_.CreatedAt.ToShortDateString()</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => EditCase(case_.Id.ToString())">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCase(case_.Id.ToString())">Delete</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">No cases found</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
</div>

@code {
    private List<CaseDto>? cases;
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCases();
    }

    private async Task LoadCases()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            cases = await Http.GetFromJsonAsync<List<CaseDto>>("api/cases");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load cases: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateModal()
    {
        NavigationManager.NavigateTo("/cases/new");
    }

    private void EditCase(string caseId)
    {
        NavigationManager.NavigateTo($"/cases/{caseId}/edit");
    }

    private async Task DeleteCase(string caseId)
    {
        if (await ConfirmDelete())
        {
            try
            {
                var response = await Http.DeleteAsync($"api/cases/{caseId}");
                if (response.IsSuccessStatusCode)
                {
                    await LoadCases();
                }
                else
                {
                    errorMessage = "Failed to delete case";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error: {ex.Message}";
            }
        }
    }

    private Task<bool> ConfirmDelete()
    {
        return Task.FromResult(true); // Replace with actual confirmation dialog
    }
}

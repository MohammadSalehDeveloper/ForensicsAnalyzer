@page "/admin"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject NavigationManager NavigationManager

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col">
            <h1>Admin Dashboard</h1>
            <p class="text-muted">System administration and management</p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">User Management</h5>
                    <p class="card-text">Manage system users and permissions</p>
                    <a href="/users" class="btn btn-primary">Go to Users</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Audit Logs</h5>
                    <p class="card-text">View system audit trail</p>
                    <a href="/audit-logs" class="btn btn-primary">View Logs</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">System Settings</h5>
                    <p class="card-text">Configure system settings</p>
                    <a href="/settings" class="btn btn-primary">Go to Settings</a>
                </div>
            </div>
        </div>
    </div>
</div>


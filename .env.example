# Copy to `.env` in the repo root (gitignored). Used by docker compose only.
# SA password must meet SQL Server complexity: 8+ chars, upper, lower, number, symbol.
# Keep this password and SQL_PORT in sync with ConnectionStrings:DefaultConnection in
# src/ForensicsAnalyzer.WebApi/appsettings.json (host port default 14330).

SA_PASSWORD=ForensicsAnalyzer_Dev!23
DB_NAME=ForensicsAnalyzerDb
SQL_PORT=14330
MSSQL_PID=Developer
